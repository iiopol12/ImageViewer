<UserControl x:Class="ImageViewer.Controls.WaterfallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ScrollViewer x:Name="WaterfallScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseLeftButtonDown="WaterfallScrollViewer_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="WaterfallScrollViewer_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="WaterfallScrollViewer_PreviewMouseLeftButtonUp"
                      Background="{DynamicResource ImageBackgroundBrush}">
            <ItemsControl x:Name="WaterfallItemsControl"
                          ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ZoomLevel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ScaleY="{Binding ZoomLevel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonUp="WaterfallItem_MouseLeftButtonUp"
                                Tag="{Binding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BackgroundLightBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Width="180" Height="140">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Margin="4"/>

                                <!-- Loading indicator -->
                                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#80000000">
                                    <TextBlock Text="..." Foreground="White" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Error indicator -->
                                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#80000000">
                                    <Path Width="24" Height="24"
                                          Stretch="Uniform"
                                          StrokeThickness="2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M3,3 L21,21 M21,3 L3,21"/>
                                </Border>

                                <!-- Bookmark indicator -->
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Fill="#FFD700"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,4,4,0"
                                      Visibility="{Binding IsBookmarked, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Data="M8,0 L9.76,5.17 L15.3,5.64 L10.8,9.02 
                                    L12.24,14.36 L8,11.4 L3.76,14.36 
                                    L5.2,9.02 L0.7,5.64 L6.24,5.17 Z"/>

                                <!-- File name overlay -->
                                <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="4,2">
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="White"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Canvas x:Name="WaterfallSelectionCanvas"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Border x:Name="WaterfallSelectionBorder"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource PrimaryBrush}"
                    Opacity="0.2"
                    Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</UserControl>
