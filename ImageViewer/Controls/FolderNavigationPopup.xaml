<!-- FolderNavigationPopup.xaml - 改进版 -->
<UserControl x:Class="ImageViewer.Controls.FolderNavigationPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500"
             Focusable="True"
             KeyDown="UserControl_KeyDown"
             KeyUp="UserControl_KeyUp"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewKeyUp="UserControl_PreviewKeyUp">

    <UserControl.Resources>
        <!-- 文件夹项模板 -->
        <DataTemplate x:Key="FolderItemTemplate">
            <Border x:Name="ItemBorder" 
                    Background="#2A2A2A" 
                    BorderBrush="#404040" 
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="4"
                    Width="100"
                    Height="90"
                    Cursor="Hand"
                    MouseLeftButtonDown="FolderItem_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 图标区域 -->
                    <Grid Grid.Row="0" HorizontalAlignment="Center" Height="40" Width="40">
                        <!-- 返回上级的箭头图标 -->
                        <Path x:Name="ParentArrow"
                              Data="M12 19V5M12 5L5 12M12 5L19 12"
                              Stroke="#FFC857"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="28" Height="28"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsParentFolder, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- 普通文件夹图标 -->
                        <Image x:Name="FolderIcon"
                               Source="{Binding Icon}"
                               Width="36" Height="36"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsParentFolder, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <!-- 加载中指示器 -->
                        <Border x:Name="LoadingIndicator"
                                Background="#3A3A3A"
                                CornerRadius="4"
                                Width="36" Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                         
                        </Border>
                    </Grid>

                    <!-- 名称 -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding DisplayName}" 
                               Foreground="#E0E0E0"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="36"
                               Margin="0,4,0,0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- 选中状态高亮 -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#3D5A80"/>
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#5B9BD5"/>
                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                </DataTrigger>

                <!-- 返回上级特殊样式 -->
                <DataTrigger Binding="{Binding IsParentFolder}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#333333"/>
                </DataTrigger>

                <!-- 返回上级 + 选中 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsParentFolder}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ItemBorder" Property="Background" Value="#4A3D2A"/>
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFC857"/>
                </MultiDataTrigger>

                <!-- 加载中显示占位图标 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLoadingIcon}" Value="True"/>
                        <Condition Binding="{Binding IsParentFolder}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LoadingIndicator" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 半透明背景遮罩 -->
    <Grid Background="#80000000">
        <!-- 居中的导航面板 -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="#1E1E1E"
                BorderBrush="#555555"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                MinWidth="300"
                MaxWidth="600"
                MaxHeight="500">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.6" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
 
                    <TextBlock Text="{DynamicResource FolderNav_Title}"  VerticalAlignment="Center" Grid.Row="0"
                               Foreground="#FFFFFF" 
                               FontSize="16"   HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               />
                   
              

                <!-- 当前路径显示 -->
                <Border Grid.Row="1" 
                        Background="#2A2A2A" 
                        CornerRadius="4" 
                        Padding="8,6"
                        Margin="0,0,0,12">
                    <TextBlock x:Name="CurrentPathText"
                               Text=""
                               Foreground="#888888"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Border>

                <!-- 搜索/过滤框 -->
                <Border Grid.Row="1" 
                        x:Name="FilterBox"
                        Background="#333333" 
                        CornerRadius="4" 
                        Padding="8,6"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                       
                        <TextBox x:Name="FilterTextBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 TextChanged="FilterTextBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- 文件夹列表 -->
                <ScrollViewer Grid.Row="2" 
                              x:Name="FolderScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="FolderScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="FolderItemsControl"
                                  ItemTemplate="{StaticResource FolderItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" 
                                           HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyState"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                  
                    <TextBlock Text="{DynamicResource FolderNav_Empty}" 
                               Foreground="#888888" 
                               FontSize="12" 
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 操作提示 - 动态文本 -->
                <Border Grid.Row="3" 
                        Background="#252525" 
                        CornerRadius="4" 
                        Padding="8,6"
                        Margin="0,12,0,0">
                    <TextBlock x:Name="HintText"
                               Foreground="#888888" 
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Text="{DynamicResource FolderNav_HintDefault}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
