<Window x:Class="ImageViewer.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="打印图片" 
        Height="600" Width="800"
        MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundMediumBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource BackgroundMediumBrush}" 
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0">
                <!-- 打印图标 -->
                <Path Data="M6 9V2h12v7 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v8H6z"
                      Stroke="{DynamicResource ForegroundBrush}"
                      StrokeThickness="1.5"
                      Width="16" Height="16"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"/>
                <TextBlock Text="打印图片" 
                           Foreground="{DynamicResource ForegroundBrush}" 
                           VerticalAlignment="Center" 
                           FontSize="13"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Click="CloseButton_Click"
                    Width="46" Height="32"
                    Background="Transparent"
                    Foreground="{DynamicResource ForegroundBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M4 4 L12 12 M12 4 L4 12"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      Stroke="{DynamicResource ForegroundBrush}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#e81123"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 预览区域 -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BackgroundDarkBrush}" 
                    CornerRadius="8"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="打印预览" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="16,12"/>

                    <!-- 纸张预览容器 -->
                    <Border Grid.Row="1" 
                            Margin="16,0,16,16"
                            Background="{DynamicResource BackgroundLightBrush}"
                            CornerRadius="4">
                        <Viewbox Stretch="Uniform" Margin="20">
                            <Border x:Name="PaperPreview"
                                    Background="White"
                                    BorderBrush="{DynamicResource ForegroundDimBrush}"
                                    BorderThickness="1"
                                    Width="210" Height="297">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" 
                                                      BlurRadius="15" 
                                                      ShadowDepth="5" 
                                                      Opacity="0.3"/>
                                </Border.Effect>
                                <Grid x:Name="PrintPreviewContainer">
                                    <Image x:Name="PreviewImage" 
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <!-- 设置面板 -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource CardBackgroundBrush}" 
                    CornerRadius="8"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 打印机选择 -->
                        <TextBlock Text="打印机" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="PrinterComboBox"
                                  SelectionChanged="PrinterComboBox_SelectionChanged"
                                  Background="{DynamicResource BackgroundLightBrush}"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BackgroundLightBrush}"
                                  Padding="8,6"
                                  Margin="0,0,0,16">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <!-- 纸张大小 -->
                        <TextBlock Text="纸张大小" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="PaperSizeComboBox"
                                  SelectionChanged="PaperSizeComboBox_SelectionChanged"
                                  Background="{DynamicResource BackgroundLightBrush}"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BackgroundLightBrush}"
                                  Padding="8,6"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="A4 (210 × 297 mm)" Tag="A4" IsSelected="True"/>
                            <ComboBoxItem Content="A3 (297 × 420 mm)" Tag="A3"/>
                            <ComboBoxItem Content="A5 (148 × 210 mm)" Tag="A5"/>
                            <ComboBoxItem Content="Letter (216 × 279 mm)" Tag="Letter"/>
                            <ComboBoxItem Content="4×6 照片 (102 × 152 mm)" Tag="4x6"/>
                            <ComboBoxItem Content="5×7 照片 (127 × 178 mm)" Tag="5x7"/>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <!-- 方向 -->
                        <TextBlock Text="方向" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="PortraitRadio" 
                                         Content="纵向" 
                                         IsChecked="True"
                                         Checked="Orientation_Changed"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         Margin="0,0,16,0"
                                         VerticalContentAlignment="Center"/>
                            <RadioButton x:Name="LandscapeRadio" 
                                         Content="横向"
                                         Checked="Orientation_Changed"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- 缩放选项 -->
                        <TextBlock Text="图片适应方式" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="ScaleModeComboBox"
                                  SelectionChanged="ScaleModeComboBox_SelectionChanged"
                                  Background="{DynamicResource BackgroundLightBrush}"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BackgroundLightBrush}"
                                  Padding="8,6"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="适应纸张（保持比例）" Tag="Fit" IsSelected="True"/>
                            <ComboBoxItem Content="填充纸张（可能裁剪）" Tag="Fill"/>
                            <ComboBoxItem Content="原始大小" Tag="Original"/>
                            <ComboBoxItem Content="拉伸填满" Tag="Stretch"/>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <!-- 份数 -->
                        <TextBlock Text="打印份数" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" 
                                    Content="-" 
                                    Click="DecreaseCopies_Click"
                                    Width="32" Height="32"
                                    Background="{DynamicResource BackgroundLightBrush}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="16"
                                    FontWeight="Bold"/>
                            <TextBox x:Name="CopiesTextBox"
                                     Grid.Column="1"
                                     Text="1"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource BackgroundLightBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderThickness="0"
                                     Margin="4,0"
                                     FontSize="14"/>
                            <Button Grid.Column="2" 
                                    Content="+" 
                                    Click="IncreaseCopies_Click"
                                    Width="32" Height="32"
                                    Background="{DynamicResource BackgroundLightBrush}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontSize="16"
                                    FontWeight="Bold"/>
                        </Grid>

                        <!-- 边距设置 -->
                        <TextBlock Text="边距 (mm)" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                <TextBlock Text="上" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                <TextBox x:Name="MarginTopTextBox" 
                                         Text="10" 
                                         TextChanged="Margin_TextChanged"
                                         Background="{DynamicResource BackgroundLightBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderThickness="0"
                                         Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                <TextBlock Text="下" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                <TextBox x:Name="MarginBottomTextBox" 
                                         Text="10" 
                                         TextChanged="Margin_TextChanged"
                                         Background="{DynamicResource BackgroundLightBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderThickness="0"
                                         Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="左" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                <TextBox x:Name="MarginLeftTextBox" 
                                         Text="10" 
                                         TextChanged="Margin_TextChanged"
                                         Background="{DynamicResource BackgroundLightBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderThickness="0"
                                         Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="右" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                <TextBox x:Name="MarginRightTextBox" 
                                         Text="10" 
                                         TextChanged="Margin_TextChanged"
                                         Background="{DynamicResource BackgroundLightBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderThickness="0"
                                         Padding="6,4"/>
                            </StackPanel>
                        </Grid>

                        <!-- 居中选项 -->
                        <CheckBox x:Name="CenterImageCheckBox"
                                  Content="图片居中"
                                  IsChecked="True"
                                  Checked="CenterImage_Changed"
                                  Unchecked="CenterImage_Changed"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  Margin="0,0,0,8"/>

                        <!-- 图片信息 -->
                        <Border Background="{DynamicResource BackgroundDarkBrush}" 
                                CornerRadius="4" 
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="图片信息" 
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="ImageInfoText"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮区域 -->
        <Border Grid.Row="2" 
                Background="{DynamicResource BackgroundDarkBrush}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           VerticalAlignment="Center"
                           FontSize="12"/>

                <Button Grid.Column="1" 
                        Content="取消" 
                        Click="CancelButton_Click"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource BackgroundLightBrush}"
                        Margin="0,0,8,0"
                        Padding="24,8"/>

                <Button Grid.Column="2" 
                        Content="打印" 
                        Click="PrintButton_Click"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="24,8">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6 9V2h12v7 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v8H6z"
                                      Stroke="White"
                                      StrokeThickness="1.5"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="打印" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
