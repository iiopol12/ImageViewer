<Window x:Class="ImageViewer.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ImageViewer.ViewModels"
        xmlns:models="clr-namespace:ImageViewer.Models"
        xmlns:controls="clr-namespace:ImageViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{DynamicResource App_Title}" 
        Height="Auto" Width="Auto"
       
        MinHeight="500" MinWidth="650"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
       
        MouseWheel="Window_MouseWheel"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        MouseMove="Window_MouseMove"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        Background="{DynamicResource BackgroundMediumBrush}"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid x:Name="MainLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BackgroundMediumBrush}" Height="32" 
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
              MouseMove="TitleBar_MouseMove"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                    <Path Data="M4 5 H20 V19 H4 Z M4 16 L9 11 L14 16 L17 13 L20 16 M7 9 A 1.5 1.5 0 1 0 7 6 A 1.5 1.5 0 1 0 7 9"
                  Stroke="{DynamicResource ForegroundBrush}"
                  StrokeThickness="2"
                  Width="18" Height="18"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource App_Title}" Foreground="{DynamicResource ForegroundBrush}" 
                           VerticalAlignment="Center" FontSize="13"/>


                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="MinimizeButton_Click"
                    Width="46" Height="32"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M3 10 H13 V12 H3 Z"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          Fill="{DynamicResource ForegroundBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeButton"
        Style="{StaticResource IconButtonStyle}"
        Click="MaximizeButton_Click"
        Width="46" Height="32"
        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <!-- 普通“最大化”图标 -->
                            <Path x:Name="MaximizeIcon_Normal"
              Width="14" Height="14"
              Stretch="Uniform"
              Stroke="{DynamicResource ForegroundBrush}"
              StrokeThickness="1.4"
              Fill="Transparent"
              Data="M3 4 H13 V14 H3 Z"/>

                            <!-- “还原”图标（重叠方框） -->
                            <Path x:Name="MaximizeIcon_Restore"
              Width="14" Height="14"
              Stretch="Uniform"
              Stroke="{DynamicResource ForegroundBrush}"
              StrokeThickness="1.4"
              Fill="Transparent"
              Data="M5 4 H13 V12 H5 Z M3 6 H11 V14 H3 Z"
              Visibility="Collapsed"/>
                        </Grid>
                    </Button>


                    <Button x:Name="CloseButton"
        Click="CloseButton_Click"
        Width="46" Height="32"
        Background="Transparent"
        Foreground="{DynamicResource ForegroundBrush}"
        BorderThickness="0"
        Cursor="Hand"
        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M4 4 L12 12 M12 4 L4 12"
          Width="12" Height="12"
          Stretch="Uniform"
          Stroke="{DynamicResource ForegroundBrush}"
          StrokeThickness="1.7"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"/>

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#e81123"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" Padding="8,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- 全屏时隐藏 -->
                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" 
                        Command="{Binding OpenFileCommand}" 
                        ToolTip="{DynamicResource ContextMenu_OpenFile}">
                            <Path Data="M6 2 L14 2 L18 6 L18 22 L6 22 Z M14 2 L14 6 L18 6" 
                          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" 
        Command="{Binding OpenFolderCommand}" 
        ToolTip="{DynamicResource ContextMenu_OpenFolder}">
                            <!-- Data说明：后背板 + 前盖板，形成开口效果 -->
                            <Path Data="M4 4 L10 4 L12 6 L20 6 L20 10 M2 10 L22 10 L20 20 L4 20 L2 10" 
          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource BackgroundLightBrush}" Margin="8,4"/>




                        <Button   Style="{StaticResource IconButtonStyle}"  FontFamily="Segoe UI Emoji"
                            Command="{Binding ZoomOutCommand}" ToolTip="{DynamicResource ContextMenu_ZoomOut}" IsEnabled="{Binding HasImages}"
                                  >
                            <Path Data="M15 3h4a2 2 0 0 1 2 2v4m0 6v4a2 2 0 0 1-2 2h-4m-6 0H5a2 2 0 0 1-2-2v-4m0-6V5a2 2 0 0 1 2-2h4 M9 11h6" 
                                     Stroke="{DynamicResource ForegroundBrush}" 
                                     StrokeThickness="2"
                                     Width="18" 
                                     Height="18"
                                     Stretch="Uniform"/>
                        </Button>

                        <TextBlock Text="{Binding ActiveZoomLevel, Converter={StaticResource ZoomToPercentConverter}}" 
                               Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" 
                               Width="50" TextAlignment="Center" FontSize="12"/>
                        <Button Style="{StaticResource IconButtonStyle}"   FontFamily="Segoe UI Emoji"
                            Command="{Binding ZoomInCommand}" ToolTip="{DynamicResource ContextMenu_ZoomIn}" IsEnabled="{Binding HasImages}">
                            <Path Data="M15 3h4a2 2 0 0 1 2 2v4m0 6v4a2 2 0 0 1-2 2h-4m-6 0H5a2 2 0 0 1-2-2v-4m0-6V5a2 2 0 0 1 2-2h4 M12 8v6 M9 11h6" 
                                     Stroke="{DynamicResource ForegroundBrush}" 
                                     StrokeThickness="2"
                                     Width="18" 
                                     Height="18"
                                     Stretch="Uniform"/>
                        </Button>
                        <Button  FontFamily="Segoe UI Symbol"
                         Command="{Binding ToggleFitToActualCommand}" IsEnabled="{Binding HasImages}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <!-- 默认样式继承IconButtonStyle -->
                                    <Style.Triggers>
                                        <!-- 当FitToWindow为True时，显示"适应窗口"图标和提示 -->
                                        <DataTrigger Binding="{Binding FitToWindow}" Value="True">
                                            <Setter Property="ToolTip" Value="{DynamicResource ToolTip_SwitchToOriginalSize}"/>
                                        </DataTrigger>
                                        <!-- 当FitToWindow为False时，显示"原始尺寸"图标和提示 -->
                                        <DataTrigger Binding="{Binding FitToWindow}" Value="False">
                                            <Setter Property="ToolTip" Value="{DynamicResource ToolTip_SwitchToFitWindow}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <!-- 根据FitToWindow状态显示不同的图标 -->
                            <Grid>
                                <!-- 适应窗口图标 - 当FitToWindow为True时显示 -->
                                <Path Data="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" 
                          Stroke="{DynamicResource ForegroundBrush}" 
                          StrokeThickness="2"
                          Width="18" 
                          Height="18"
                          Stretch="Uniform"
                          Visibility="{Binding FitToWindow, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- 原始尺寸图标 - 当FitToWindow为False时显示 -->
                                <Path Data="M3 3h18v18H3z M8 8h8v8H8z" 
                              Stroke="{DynamicResource ForegroundBrush}" 
                              StrokeThickness="2"
                              Width="18" 
                              Height="18"
                              Stretch="Uniform"
                              Visibility="{Binding FitToWindow, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </Grid>
                        </Button>
                    </StackPanel>



                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource ToolTip_SingleMode}" 
                        IsEnabled="{Binding HasImages}"
                        Command="{Binding SetViewModeCommand}" 
                        CommandParameter="{x:Static models:ViewMode.Single}">
                            <Path Data="M5 4 H19 V20 H5 Z" 
                          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <!-- 漫画模式 (Vertical Scroll/Strip) -->
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource ToolTip_MangaMode}" 
                        IsEnabled="{Binding HasImages}"
                        Command="{Binding SetViewModeCommand}" 
                        CommandParameter="{x:Static models:ViewMode.Manga}">
                            <!-- 长方形内部有横线，表示连续阅读 -->
                            <Path Data="M6 3 H18 V21 H6 Z M6 9 H18 M6 15 H18" 
                          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <!-- 双页模式 (Two Rectangles) -->
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource ToolTip_DoublePageMode}" 
                            IsEnabled="{Binding HasImages}"
                            Command="{Binding SetViewModeCommand}" 
                            CommandParameter="{x:Static models:ViewMode.DoublePage}">
                            <Path Data="M2 6 H11 V18 H2 Z M13 6 H22 V18 H13 Z" 
                              Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <Rectangle Width="1" Fill="{DynamicResource BackgroundLightBrush}" Margin="8,4"/>

                        <Button Style="{StaticResource IconButtonStyle}"
                        FontFamily="Segoe UI Symbol"
                        Command="{Binding Rotate90Command}"
                       ToolTip="{DynamicResource ToolTip_Rotate90}"
                        IsEnabled="{Binding HasImages}"
                        FontSize="18">
                            <Path
                        Data="M409.6 864c32 12.8 67.2 19.2 102.4 19.2 22.4 0 38.4 19.2 38.4 41.6s-19.2 38.4-41.6 38.4c-41.6-3.2-86.4-9.6-128-22.4-22.4-6.4-32-28.8-25.6-51.2s32-35.2 54.4-25.6z m371.2-28.8c12.8 19.2 6.4 44.8-12.8 54.4-35.2 22.4-76.8 41.6-118.4 54.4-22.4 6.4-44.8-6.4-48-28.8-6.4-22.4 6.4-44.8 28.8-48 35.2-9.6 67.2-25.6 96-44.8 16-9.6 41.6-6.4 54.4 12.8zM227.2 726.4c19.2 28.8 44.8 54.4 73.6 76.8 16 12.8 19.2 38.4 6.4 57.6-12.8 16-38.4 19.2-57.6 6.4-35.2-25.6-64-57.6-89.6-92.8-12.8-19.2-9.6-41.6 9.6-54.4s44.8-9.6 57.6 6.4z m691.2-92.8c19.2 9.6 28.8 32 22.4 51.2-16 38.4-38.4 76.8-64 112-12.8 16-38.4 19.2-57.6 6.4s-19.2-38.4-6.4-57.6c22.4-28.8 41.6-57.6 54.4-89.6 6.4-22.4 32-32 51.2-22.4zM867.2 60.8c19.2 0 35.2 12.8 35.2 28.8V294.4c0 19.2-12.8 35.2-28.8 35.2h-195.2c-16 0-28.8-16-28.8-35.2 0-19.2 12.8-35.2 28.8-35.2h105.6c-67.2-67.2-160-108.8-259.2-108.8C326.4 150.4 160 313.6 160 515.2c0 44.8 9.6 92.8 25.6 134.4 9.6 19.2-3.2 44.8-22.4 51.2-19.2 9.6-44.8-3.2-51.2-22.4-19.2-51.2-32-105.6-32-163.2 0-246.4 198.4-444.8 444.8-444.8 115.2 0 224 44.8 304 121.6V89.6c3.2-16 19.2-28.8 38.4-28.8z"
                        Fill="{DynamicResource ForegroundBrush}"
                        Width="18"
                        Height="18"
                        Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource ToolTip_Bookmark}" 
                            Command="{Binding ToggleBookmarkCommand}" IsEnabled="{Binding HasImages}"
                            FontSize="16">
                            <Path x:Name="BookmarkIcon"
                                 Data="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" 
                                 Stroke="{DynamicResource ForegroundBrush}" 
                                 StrokeThickness="2"
                                 Width="18" 
                                 Height="18"
                                 Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource ToolTip_ShareCurrentImage}" 
                            Command="{Binding ShareCurrentImageCommand}" IsEnabled="{Binding HasImages}">
                            <Path Data="M3 11 L21 3 12 21 11 13 3 11 Z M11 13 L21 3" 
                              Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource ToolTip_Print}" 
                            Click="PrintButton_Click" IsEnabled="{Binding HasImages}">
                            <!-- 打印机图标 -->
                            <Path Data="M6 9V2h12v7 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v8H6z"
                                  Stroke="{DynamicResource ForegroundBrush}" 
                                  StrokeThickness="2" 
                                  Width="18" 
                                  Height="18" 
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe UI Symbol"
                            Command="{Binding ToggleSlideShowCommand}" ToolTip="{DynamicResource ToolTip_SlideShow}" IsEnabled="{Binding HasImages}">
                            <Path x:Name="PlayIcon"
                                 Data="M5 3l14 9-14 9V3" 
                                 Stroke="{DynamicResource ForegroundBrush}" 
                                 StrokeThickness="2"
                                 Width="18" 
                                 Height="18"
                                 Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"  FontFamily="Segoe UI Symbol"
                            Command="{Binding ToggleFullScreenCommand}" ToolTip="{DynamicResource ToolTip_FullScreen}" FontSize="18">
                            <Path Data="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" 
                                 Stroke="{DynamicResource ForegroundBrush}" 
                                 StrokeThickness="2"
                                 Width="18" 
                                 Height="18"
                                 Stretch="Uniform"/>
                        </Button>

                        <Rectangle Width="1" Fill="{DynamicResource BackgroundLightBrush}" Margin="8,4"/>

                        <Button Style="{StaticResource IconButtonStyle}" 
                        Command="{Binding ToggleSidebarCommand}" 
                        ToolTip="{DynamicResource ToolTip_ToggleSidebar}"
                             IsEnabled="{Binding IsMangaMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <!-- 外框 + 左侧分割线 -->
                            <Path Data="M4 4 H20 V20 H4 Z M9 4 V20" 
                          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" 
                        Command="{Binding ToggleWaterfallViewCommand}" 
                        ToolTip="{DynamicResource ToolTip_ToggleWaterfallView}"
                        IsEnabled="{Binding HasImages}">
                            <!-- 瀑布流网格图标 -->
                            <Path Data="M3 3h8v6H3z M13 3h8v10h-8z M3 11h8v10H3z M13 15h8v6h-8z"
                          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                          Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area - 覆盖层设计 -->
            <Grid Grid.Row="2">
                <!-- 图片显示区域占满整个空间，侧边栏和底边栏作为覆盖层叠加 -->

                <!-- ========== 图片显示区域（始终居中，不受侧边栏影响） ========== -->
                <Grid>
                    <!-- ========== 图片显示区域 ========== -->
                    <!-- Image Display Area -->
                    <Grid Background="{DynamicResource ImageBackgroundBrush}">

                        <!-- Single/Double Page Mode -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- 漫画模式时隐藏 -->
                                        <DataTrigger Binding="{Binding IsMangaMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <!-- 瀑布流显示时隐藏 -->
                                        <DataTrigger Binding="{Binding ShowWaterfallView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer x:Name="ImageScrollViewer"
                      PanningMode="Both"
                      SizeChanged="ImageScrollViewer_SizeChanged">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FitToWindow}" Value="True">
                                                <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
                                                <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <Grid x:Name="ImageContainer" 
                  MouseLeftButtonDown="ImageContainer_MouseLeftButtonDown"
                  MouseLeftButtonUp="ImageContainer_MouseLeftButtonUp"
                  MouseMove="ImageContainer_MouseMove"
                  Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="ImageScaleTransform" 
                                    ScaleX="{Binding ZoomLevel}" 
                                    ScaleY="{Binding ZoomLevel}"/>
                                    </Grid.LayoutTransform>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Center">
                                        <!-- 静态图片显示（非动画 GIF 或其他格式） -->
                                        <Image x:Name="MainImage" Source="{Binding DisplayImage}" 
                             Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <!-- 仅在非动画 GIF 时显示 -->
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentAnimatedGif}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Opacity" Value="0"/>
                                                        </Trigger>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- GIF 动画播放控件（仅动画 GIF 时显示） -->
                                        <controls:GifViewerControl x:Name="GifViewer"
                               Source="{Binding CurrentGifData}"
                               IsPlaying="True"
                               Speed="1.0"
                               LoopMode="Infinite">
                                            <controls:GifViewerControl.Style>
                                                <Style TargetType="controls:GifViewerControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentAnimatedGif}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:GifViewerControl.Style>
                                        </controls:GifViewerControl>


                                        <Image x:Name="SecondImageControl" Source="{Binding SecondDisplayImage}" 
                           Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IsDoublePage, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Click Zones -->
                            <Grid Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧点击区域 -->
                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                 MouseLeftButtonUp="PreviousZone_Click"
                                x:Name="PreviousZone">
                                    <!-- 左箭头提示 -->
                                    <Path Data="M15 18l-6-6 6-6" 
                                          Stroke="{DynamicResource ForegroundBrush}" 
                                          StrokeThickness="3"
                                          Width="40" 
                                          Height="40"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0">
                                        <Path.Effect>
                                            <DropShadowEffect Color="Black" 
                                          Direction="0" 
                                          ShadowDepth="0" 
                                          BlurRadius="8" 
                                          Opacity="0.5"/>
                                        </Path.Effect>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <!-- 鼠标悬停时显示 -->
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PreviousZone}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                      To="0.7" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                  To="0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>

                                <!-- 右侧点击区域 -->
                                <Border Grid.Column="2" Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonUp="NextZone_Click"
                                        x:Name="NextZone">
                                    <!-- 右箭头提示 -->
                                    <Path Data="M9 18l6-6-6-6" 
                                          Stroke="{DynamicResource ForegroundBrush}" 
                                          StrokeThickness="3"
                                          Width="40" 
                                          Height="40"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0">
                                        <Path.Effect>
                                            <DropShadowEffect Color="Black" 
                                          Direction="0" 
                                          ShadowDepth="0" 
                                          BlurRadius="8" 
                                          Opacity="0.5"/>
                                        </Path.Effect>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <!-- 鼠标悬停时显示 -->
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=NextZone}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0.7" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Manga Mode -->
                        <ScrollViewer x:Name="MangaScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseLeftButtonDown="MangaScrollViewer_PreviewMouseLeftButtonDown"
                  ScrollChanged="MangaScrollViewer_ScrollChanged"
                  MouseLeftButtonDown="MangaScrollViewer_MouseLeftButtonDown">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- 仅在漫画模式且非瀑布流时显示 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMangaMode}" Value="True"/>
                                                <Condition Binding="{Binding ShowWaterfallView}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid>
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding MangaZoomLevel}"
                                ScaleY="{Binding MangaZoomLevel}"/>
                                </Grid.LayoutTransform>

                                <ItemsControl x:Name="MangaItemsControl"
                          ItemsSource="{Binding Images}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="{Binding DataContext.Settings.MangaGap, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DoubleToThicknessConverter}}"
                                Background="{DynamicResource BackgroundDarkBrush}" 
                                CornerRadius="0"
                                Cursor="Hand"
                                BorderThickness="0"
                                MouseLeftButtonUp="WaterfallItem_Click"
                                Tag="{Binding}">
                                                <Border.MinHeight>
                                                    <MultiBinding Converter="{StaticResource MangaPlaceholderHeightConverter}">
                                                        <Binding Path="FullImage"/>
                                                        <Binding Path="Thumbnail"/>
                                                        <Binding ElementName="RootWindow" Path="DataContext.Settings.MangaDecodeWidth"/>
                                                    </MultiBinding>
                                                </Border.MinHeight>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Image Stretch="Uniform" 
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MaxWidth="{Binding ElementName=RootWindow, Path=DataContext.Settings.MangaDecodeWidth, FallbackValue=1600}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource MangaImageSourceConverter}">
                                                            <Binding Path="FullImage"/>
                                                            <Binding Path="Thumbnail"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <!-- Waterfall View (瀑布流视图) -->
                        <ScrollViewer x:Name="WaterfallScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseLeftButtonDown="WaterfallScrollViewer_PreviewMouseLeftButtonDown"
                  Background="{DynamicResource ImageBackgroundBrush}"
                  Visibility="{Binding ShowWaterfallView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding WaterfallZoomLevel}" ScaleY="{Binding WaterfallZoomLevel}"/>
                                </ItemsControl.LayoutTransform>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Background="{DynamicResource BackgroundDarkBrush}" 
                            CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="WaterfallItem_Click"
                            Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BackgroundLightBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Width="180" Height="140">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" 
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="4"/>

                                                <!-- Loading indicator -->
                                                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#80000000">
                                                    <TextBlock Text="..." Foreground="White" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Error indicator -->
                                                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#80000000">
                                                    <Path Width="24" Height="24"
                                      Stretch="Uniform"
     
                                      StrokeThickness="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M3,3 L21,21 M21,3 L3,21"/>
                                                </Border>

                                                <!-- Bookmark indicator -->
                                                <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Fill="#FFD700"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,4,4,0"
                              Visibility="{Binding IsBookmarked, Converter={StaticResource BoolToVisibilityConverter}}"
                              Data="M8,0 L9.76,5.17 L15.3,5.64 L10.8,9.02 
                                    L12.24,14.36 L8,11.4 L3.76,14.36 
                                    L5.2,9.02 L0.7,5.64 L6.24,5.17 Z"/>

                                                <!-- File name overlay -->
                                                <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="4,2">
                                                    <TextBlock Text="{Binding FileName}" 
                                           Foreground="White"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Path
                                Data="
                            M4 5 H20 V19 H4 Z
                            M4 16 L9 11 L14 16 L17 13 L20 16
                            M7 9 A 1.5 1.5 0 1 0 7 6 A 1.5 1.5 0 1 0 7 9
                            M17 18 A 3 3 0 1 0 23 18 A 3 3 0 1 0 17 18
                            M22 20 L25 23"
                                Stroke="{DynamicResource ForegroundBrush}"
                                StrokeThickness="4"
                                Width="72"
                                Height="72"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.3" />
                            <TextBlock Text="{DynamicResource MainWindow_DragDropHint}" 
                   Foreground="{DynamicResource ForegroundDimBrush}"
                   FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource MainWindow_ClickToolbarHint}" 
                   Foreground="{DynamicResource ForegroundDimBrush}"
                   FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.7"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                <Button Content="{DynamicResource Button_OpenImage}" Style="{StaticResource ModernButtonStyle}"
                    Command="{Binding OpenFileCommand}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Button_OpenFolder}" Style="{StaticResource ModernButtonStyle}"
                    Command="{Binding OpenFolderCommand}"/>
                            </StackPanel>



                            <!-- 快捷键指南 -->
                            <Border Background="{DynamicResource BackgroundLightBrush}"
                    CornerRadius="8"
                    Padding="24,16"
                    Margin="0,32,0,0"
                    BorderBrush="{DynamicResource ForegroundDimBrush}"
                    BorderThickness="1"
                    MaxWidth="800">
                                <Border.Effect>
                                    <DropShadowEffect Color="#80000000" 
                              Opacity="0.3" 
                              BlurRadius="10" 
                              ShadowDepth="3"/>
                                </Border.Effect>

                                <StackPanel>
                                    <!-- 标题 -->
                                    <TextBlock Text="{DynamicResource MainWindow_ShortcutGuide}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                                    <!-- 主分隔线 -->
                                    <Border Height="1"
                            Background="{DynamicResource ForegroundDimBrush}"
                            Opacity="0.3"
                            Margin="0,0,0,16"/>

                                    <!-- 两列布局 -->
                                    <Grid>
                                        <Grid.Resources>
                                            <!-- 按键样式 -->
                                            <Style x:Key="KeyStyle" TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
                                                <Setter Property="CornerRadius" Value="3"/>
                                                <Setter Property="Padding" Value="6,3"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>

                                            <Style x:Key="KeyTextStyle" TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>

                                            <Style x:Key="DescTextStyle" TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>

                                            <Style x:Key="CategoryStyle" TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                            </Style>
                                        </Grid.Resources>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左列 -->
                                        <StackPanel Grid.Column="0">
                                            <!-- 文件操作 -->
                                            <TextBlock Text="{DynamicResource ShortcutGuide_FileOperations}" Style="{StaticResource CategoryStyle}"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="Ctrl+O" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="Ctrl+F" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_OpenFileFolder}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="Ctrl+Tab" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_FavoriteFolderSwitch}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="Ctrl+Shift+B" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_OpenFavoritesPage}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>

                                            <!-- 图片导航 -->
                                            <TextBlock Text="{DynamicResource ShortcutGuide_ImageNavigation}" Style="{StaticResource CategoryStyle}" Margin="0,12,0,6"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="← →" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="A D" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_PreviousNextImage}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="Space" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_NextImage}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="PgUp" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="PgDn" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_PreviousNextImage}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="Home" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="End" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_FirstLastImage}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>

                                            <!-- 视图控制 -->
                                            <TextBlock Text="{DynamicResource ShortcutGuide_ViewControl}" Style="{StaticResource CategoryStyle}" Margin="0,12,0,6"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="F11" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_ToggleFullScreen}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="ESC" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_ExitFullScreenClose}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="+" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource KeyStyle}">
                                                        <TextBlock Text="-" Style="{StaticResource KeyTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_ZoomInOut}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="Ctrl+0" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_FitActualToggle}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 中间分隔线 -->
                                        <Border Grid.Column="1" Width="1" 
                                            Background="{DynamicResource ForegroundDimBrush}"
                                            Opacity="0.3"
                                            Margin="12,0"/>

                                        <!-- 右列 -->
                                        <StackPanel Grid.Column="2">
                                            <!-- 功能操作 -->
                                            <TextBlock Text="{DynamicResource ShortcutGuide_FunctionOperations}" Style="{StaticResource CategoryStyle}"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="M" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_SwitchViewMode}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="S" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_StartStopSlideshow}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="B" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_ToggleBookmark}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="Ctrl+C" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_CopyToClipboard}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="Delete" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_DeleteImage}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="Ctrl+Shift+F" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_ToggleFilter}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource KeyStyle}">
                                                    <TextBlock Text="Ctrl+P" Style="{StaticResource KeyTextStyle}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource Shortcut_Print}" Style="{StaticResource DescTextStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>


                        </StackPanel>

                        <!-- Image Info Panel -->
                        <Border x:Name="ImageInfoPanel"
            Padding="12"
            Background="#CC000000"
            CornerRadius="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12"
            MaxWidth="360">
                            <Border.Effect>
                                <DropShadowEffect Color="#99000000" BlurRadius="12" ShadowDepth="0"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInfoPanelVisible}" Value="True"/>
                                                <Condition Binding="{Binding HasImages}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource IconButtonStyle}"
                    Command="{Binding ToggleInfoPanelCommand}"
                    ToolTip="{DynamicResource ToolTip_CloseInfoPanel}">
                                    <Path Data="M6 6 L18 18 M18 6 L6 18"
                      Stroke="{DynamicResource ForegroundBrush}"
                      StrokeThickness="2"
                      Width="14" Height="14" Stretch="Uniform"/>
                                </Button>

                                <StackPanel Grid.Column="0" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CurrentImage.FileName}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="320"/>
                                    <TextBlock Text="{Binding PositionText}"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           FontSize="11" Margin="0,2,0,6"/>
                                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="12">
                                        <Run Text="{DynamicResource InfoPanel_Dimensions}"/>
                                        <Run Text="{Binding CurrentImage.DimensionsFormatted, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="12" Margin="0,2,0,0">
                                        <Run Text="{DynamicResource InfoPanel_BitDepth}"/>
                                        <Run Text="{Binding CurrentImage.BitDepth, Mode=OneWay}"/>
                                        <Run Text="{DynamicResource InfoPanel_BitDepthSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="12" Margin="0,2,0,0">
                                        <Run Text="{DynamicResource InfoPanel_FileSize}"/>
                                        <Run Text="{Binding CurrentImage.FileSizeFormatted, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="12" Margin="0,2,0,0">
                                        <Run Text="{DynamicResource InfoPanel_DateModified}"/>
                                        <Run Text="{Binding CurrentImage.DateModified, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CurrentImage.FilePath}"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           FontSize="11"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="320"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Loading Overlay -->
                        <Border Background="#80000000" 
            Visibility="{Binding IsBusyLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⟳" FontSize="48" Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="LoadingRotation"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource Status_Loading}" Foreground="White" FontSize="14" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========== 漫画模式侧边栏（左侧纵向）- 覆盖层设计 ========== -->
                <Border x:Name="MangaSidebar" 
                    HorizontalAlignment="Left"
                    Background="{DynamicResource BackgroundMediumBrush}"
                    Width="{Binding Settings.SidebarWidth}"
                    Panel.ZIndex="50">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.4" Direction="0"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 漫画模式且显示侧边栏且非全屏时显示 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMangaMode}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowSidebar}" Value="True"/>
                                        <Condition Binding="{Binding IsFullScreen}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- 侧边栏内容 - 纵向列表 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource BackgroundLightBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Sidebar_Title}" Foreground="{DynamicResource ForegroundBrush}" 
                                       FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource ForegroundDimBrush}" 
                                       FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="28" Height="28"
                                    Margin="8,0,0,0"
                                    ToolTip="{DynamicResource ToolTip_BookmarkCurrentFolder}"
                                    Command="{Binding ToggleCurrentFolderBookmarkCommand}"
                                    IsEnabled="{Binding IsCurrentFolderBookmarkAvailable}">
                                    <Grid>
                                        <Path Data="M12 2 L15 9 H22 L17 13 L19 20 L12 16 L5 20 L7 13 L2 9 H9 Z"
                                          Stroke="{DynamicResource ForegroundBrush}"
                                          StrokeThickness="1.6"
                                          Fill="Transparent"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Visibility="{Binding IsCurrentFolderBookmarked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <Path Data="M12 2 L15 9 H22 L17 13 L19 20 L12 16 L5 20 L7 13 L2 9 H9 Z"
                                          Fill="{DynamicResource PrimaryBrush}"
                                          Stroke="{DynamicResource PrimaryBrush}"
                                          StrokeThickness="1.2"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Visibility="{Binding IsCurrentFolderBookmarked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 漫画模式纵向缩略图列表 -->
                        <ListBox x:Name="MangaThumbnailList"
                             Grid.Row="1" 
                             ItemsSource="{Binding Images}" 
                             SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}"
                             SelectionChanged="ThumbnailList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="10,10"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="160" ToolTip="{Binding FileName}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="2">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" 
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#80000000">
                                                    <TextBlock Text="..." Foreground="White" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Path Width="16" Height="16"
                                              Stretch="Uniform"
                                              Fill="#FFD700"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top"
                                              Margin="0,4,4,0"
                                              Visibility="{Binding IsBookmarked, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Data="M8,0 L9.76,5.17 L15.3,5.64 L10.8,9.02 L12.24,14.36 L8,11.4 L3.76,14.36 L5.2,9.02 L0.7,5.64 L6.24,5.17 Z"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1" Text="{Binding FileName}" 
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" TextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ========== 单图/双页模式底边栏（底部横向）- 覆盖层设计 ========== -->
                <Border x:Name="BottomThumbnailBar"
            VerticalAlignment="Bottom"
            Background="{DynamicResource BackgroundMediumBrush}"
            Height="{Binding Settings.BottomBarHeight}"
            Panel.ZIndex="50">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.4" Direction="270"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 非漫画模式且显示侧边栏且非全屏时显示 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMangaMode}" Value="False"/>
                                        <Condition Binding="{Binding Settings.ShowSidebar}" Value="True"/>
                                        <Condition Binding="{Binding IsFullScreen}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- 底边栏内容 - 横向列表 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 标题区 -->
                        <Border Grid.Column="0" Padding="12,8" Background="{DynamicResource BackgroundLightBrush}" Width="120">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Sidebar_Title}" Foreground="{DynamicResource ForegroundBrush}" 
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource ForegroundDimBrush}" 
                               FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Row="1"
                            Style="{StaticResource IconButtonStyle}"
                            Width="28" Height="28"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            ToolTip="{DynamicResource ToolTip_BookmarkCurrentFolder}"
                            Command="{Binding ToggleCurrentFolderBookmarkCommand}"
                            IsEnabled="{Binding IsCurrentFolderBookmarkAvailable}">
                                    <Grid>
                                        <Path Data="M12 2 L15 9 H22 L17 13 L19 20 L12 16 L5 20 L7 13 L2 9 H9 Z"
                                  Stroke="{DynamicResource ForegroundBrush}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Visibility="{Binding IsCurrentFolderBookmarked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <Path Data="M12 2 L15 9 H22 L17 13 L19 20 L12 16 L5 20 L7 13 L2 9 H9 Z"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Visibility="{Binding IsCurrentFolderBookmarked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 横向缩略图列表 -->
                        <ListBox x:Name="BottomThumbnailList"
                     Grid.Column="1"
                     ItemsSource="{Binding Images}" 
                     SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Visible"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}"
                     SelectionChanged="ThumbnailList_SelectionChanged"
                     PreviewMouseWheel="BottomThumbnailList_PreviewMouseWheel"
                                
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.CacheLength="10,10"         
                     VirtualizingPanel.CacheLengthUnit="Item"
                     VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="100" Margin="4" ToolTip="{Binding FileName}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="2">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" 
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Path Width="14" Height="14"
                                      Stretch="Uniform"
                                      Fill="#FFD700"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,2,2,0"
                                      Visibility="{Binding IsBookmarked, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Data="M8,0 L9.76,5.17 L15.3,5.64 L10.8,9.02 L12.24,14.36 L8,11.4 L3.76,14.36 L5.2,9.02 L0.7,5.64 L6.24,5.17 Z"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding FileName}" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" TextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ========== 全屏模式下的自动显示面板 ========== -->

                <!-- 全屏底边栏（单图/双页模式） - 覆盖层 -->
                <Border x:Name="FullScreenBottomBar"
            VerticalAlignment="Bottom"
            Background="{DynamicResource BackgroundMediumBrush}"
            Height="{Binding Settings.BottomBarHeight}"
            Opacity="0"
            IsHitTestVisible="False"
            Panel.ZIndex="100">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5" Direction="270"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 全屏、非漫画模式、启用自动显示时激活 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFullScreen}" Value="True"/>
                                        <Condition Binding="{Binding IsMangaMode}" Value="False"/>
                                        <Condition Binding="{Binding Settings.ShowBottomBarInFullScreen}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- 横向缩略图内容 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="12,8" Background="{DynamicResource BackgroundLightBrush}" Width="120">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Sidebar_Title}" Foreground="{DynamicResource ForegroundBrush}" 
                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource ForegroundDimBrush}" 
                           FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="FullScreenBottomThumbnailList"
                     Grid.Column="1"
                     ItemsSource="{Binding Images}" 
                     SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Visible"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="ThumbnailList_SelectionChanged"
                     PreviewMouseWheel="BottomThumbnailList_PreviewMouseWheel"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="100" Margin="4" ToolTip="{Binding FileName}">
                                        <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="2">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 全屏侧边栏（漫画模式） - 覆盖层 -->
                <Border x:Name="FullScreenSidebar"
            HorizontalAlignment="Left"
            Background="{DynamicResource BackgroundMediumBrush}"
            Width="{Binding Settings.SidebarWidth}"
            Opacity="0"
            IsHitTestVisible="False"
            Panel.ZIndex="100">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5" Direction="0"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 全屏、漫画模式、启用自动显示时激活 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFullScreen}" Value="True"/>
                                        <Condition Binding="{Binding IsMangaMode}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowSidebarInMangaFullScreen}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- 纵向缩略图内容 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource BackgroundLightBrush}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Sidebar_Title}" Foreground="{DynamicResource ForegroundBrush}" 
                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource ForegroundDimBrush}" 
                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="FullScreenSidebarThumbnailList"
                     Grid.Row="1" 
                     ItemsSource="{Binding Images}" 
                     SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ThumbnailList_SelectionChanged"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="160" ToolTip="{Binding FileName}" Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="2">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding FileName}" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" TextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource BackgroundMediumBrush}" Padding="12,6"
                Visibility="{Binding Settings.ShowStatusBar, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Width="32" Height="26"
                        Command="{Binding ToggleBookmarkCommand}"
                        ToolTip="{DynamicResource ToolTip_BookmarkCurrentImage}"
                        Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSingleMode}" Value="True"/>
                                            <Condition Binding="{Binding HasImages}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Path Data="M12 2 L15 9 H22 L17 13 L19 20 L12 16 L5 20 L7 13 L2 9 H9 Z"
                              Stroke="{DynamicResource ForegroundBrush}"
                              StrokeThickness="1.8"
                              Fill="Transparent"
                              Width="18" Height="18" Stretch="Uniform"
                              Visibility="{Binding CurrentImage.IsBookmarked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            <Path Data="M12 2 L15 9 H22 L17 13 L19 20 L12 16 L5 20 L7 13 L2 9 H9 Z"
                              Fill="{DynamicResource PrimaryBrush}"
                              Stroke="{DynamicResource PrimaryBrush}"
                              StrokeThickness="1.2"
                              Width="18" Height="18" Stretch="Uniform"
                              Visibility="{Binding CurrentImage.IsBookmarked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="32" Height="26"
                        Command="{Binding ToggleInfoPanelCommand}"
                        ToolTip="{DynamicResource ToolTip_ViewImageInfo}" Margin="0,0,8,0"
                        IsEnabled="{Binding HasImages}">
                        <Path Data="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6z M12 8v2 M12 12v5"
                  Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8"  StrokeLineJoin="Round"
                  Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" 
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           FontSize="12" VerticalAlignment="Center"/>

                    <Slider Grid.Column="3" Width="200" Minimum="0"
                        Maximum="{Binding Images.Count}"
                        Value="{Binding CurrentIndex, Mode=TwoWay}"
                        Margin="20,0">
                        <Slider.Style>
                            <Style TargetType="Slider" BasedOn="{StaticResource ModernSliderStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasImages}" Value="True"/>
                                            <Condition Binding="{Binding IsSingleMode}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Slider.Style>
                    </Slider>

                    <TextBlock Grid.Column="4" Text="{Binding PositionText}" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="12" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Resize freeze layer: show snapshot + border during drag -->
        <!-- Favorite folder switch overlay (Ctrl+Tab) -->
        <Grid x:Name="FolderSwitchOverlay"
              Panel.ZIndex="10000"
              Visibility="Collapsed"
              Background="#80000000"
              MouseDown="FolderSwitchOverlay_MouseDown">
            <Border Background="{DynamicResource BackgroundMediumBrush}"
                    BorderBrush="{DynamicResource BackgroundLightBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="FolderSwitchOverlayContent_MouseDown">
                <Border.Resources>
                    <Style x:Key="FolderSwitchListBoxItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="IsEnabled" Value="{Binding Exists}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{DynamicResource BackgroundDarkBrush}"
                                            BorderBrush="Transparent"
                                            BorderThickness="2"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BackgroundLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <StackPanel>
                    <TextBlock Text="{DynamicResource FolderSwitch_Title}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FolderSwitchBasePathText"
                               Foreground="{DynamicResource ForegroundDimBrush}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="620"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FolderSwitchMoreLeft"
                                   Grid.Column="0"
                                   Text="…"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed"/>

                        <ListBox x:Name="FolderSwitchListBox"
                                 Grid.Column="1"
                                 Width="560"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="True"
                                 IsTabStop="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource FolderSwitchListBoxItemStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="7"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6" HorizontalAlignment="Center">
                                        <Grid Width="36" Height="36">
                                            <Border x:Name="CoverBorder"
                                                    Background="{DynamicResource BackgroundDarkBrush}"
                                                    CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Visibility="{Binding CoverThumbnail, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Image Source="{Binding CoverThumbnail}" Stretch="UniformToFill"/>
                                            </Border>
                                            <Grid x:Name="FolderIconGrid"
                                                  Visibility="{Binding CoverThumbnail, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                                <Path x:Name="FolderIcon"
                                                      Data="M4 4 L10 4 L12 6 L20 6 L20 10 M2 10 L22 10 L20 20 L4 20 L2 10"
                                                      Stroke="{DynamicResource ForegroundBrush}"
                                                      StrokeThickness="2"
                                                      Stretch="Uniform"/>
                                                <Path x:Name="ParentIcon"
                                                      Data="M12 4 L6 10 H10 V20 H14 V10 H18 Z"
                                                      Stroke="{DynamicResource ForegroundBrush}"
                                                      StrokeThickness="2"
                                                      Fill="Transparent"
                                                      Stretch="Uniform"
                                                      Visibility="Collapsed"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsParent}" Value="True">
                                            <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="ParentIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="FolderSwitchMoreRight"
                                   Grid.Column="2"
                                   Text="…"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource FolderSwitch_Instructions}"
                               Foreground="{DynamicResource ForegroundDimBrush}"
                               FontSize="11"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Image x:Name="ResizeFreezeImage"
               Panel.ZIndex="9998"
               Visibility="Collapsed"
               IsHitTestVisible="False"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Stretch="None"/>
        <Border x:Name="ResizeFreezeBorder"
                Panel.ZIndex="9999"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                BorderBrush="{DynamicResource ForegroundDimBrush}"
                BorderThickness="2"
                Background="Transparent"
                Margin="1"/>

    </Grid>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{DynamicResource ContextMenu_OpenFile}" Command="{Binding OpenFileCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_OpenFolder}" Command="{Binding OpenFolderCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_Previous}" Command="{Binding GoPreviousCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_Next}" Command="{Binding GoNextCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_ZoomIn}" Command="{Binding ZoomInCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_ZoomOut}" Command="{Binding ZoomOutCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_ZoomToFit}" Command="{Binding ZoomToFitCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_ZoomToActual}" Command="{Binding ZoomToActualCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_Rotate90}" Command="{Binding Rotate90Command}"/>
            <MenuItem Header="{DynamicResource ContextMenu_ToggleBookmark}" Command="{Binding ToggleBookmarkCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_CopyToClipboard}" Command="{Binding CopyToClipboardCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_ShareCurrentImage}" Command="{Binding ShareCurrentImageCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_OpenInExplorer}" Command="{Binding OpenInExplorerCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_DeleteImage}" Command="{Binding DeleteImageCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_Print}" Click="PrintMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_FullScreen}" Command="{Binding ToggleFullScreenCommand}"/>
            <MenuItem Header="{DynamicResource ContextMenu_SlideShow}" Command="{Binding ToggleSlideShowCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_ToggleViewMode}" Command="{Binding ToggleViewModeCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource ContextMenu_Settings}" Click="OpenSettingsMenuItem_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
