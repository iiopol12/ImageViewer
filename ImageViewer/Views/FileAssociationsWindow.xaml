<Window x:Class="ImageViewer.Views.FileAssociationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择关联格式"
        Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="选择要关联的图片格式"
                   Foreground="{StaticResource ForegroundBrush}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  Margin="0,0,12,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="全选" Style="{StaticResource ModernButtonStyle}" Width="70" Margin="0,0,8,0"
                    Click="SelectAll_Click"/>
            <Button Content="取消全选" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="0,0,8,0"
                    Click="ClearAll_Click"/>
            <Button Content="关联所选" Style="{StaticResource ModernButtonStyle}" Width="90" Margin="0,0,8,0"
                    Click="Apply_Click"/>
            <Button Content="取消" Style="{StaticResource ModernButtonStyle}" Width="70"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

