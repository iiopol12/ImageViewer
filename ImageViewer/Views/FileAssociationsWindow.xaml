<UserControl x:Class="ImageViewer.Views.FileAssociationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Associations_Subtitle}"
                   
                   Foreground="{StaticResource ForegroundBrush}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  Margin="0,0,12,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="{DynamicResource Button_SelectAll}" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="0,0,8,0"
                    Click="SelectAll_Click"/>
            <Button Content="{DynamicResource Button_DeselectAll}" Style="{StaticResource ModernButtonStyle}" Width="80"
                    Click="ClearAll_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
