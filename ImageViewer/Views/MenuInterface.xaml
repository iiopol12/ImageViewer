<Window x:Class="ImageViewer.Views.MenuInterface"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ImageViewer.Models"
       Title="{DynamicResource Settings_WindowTitle}"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundDarkBrush}">

   
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧按钮栏 - 黑色背景 -->
        <Grid Grid.Column="0" Background="{DynamicResource BackgroundDarkBrush}">
            <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">

                <!-- 设置 -->
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,0" Height="60"
                        Click="SettingsNavButton_Click">
                    <StackPanel>
                        <Path x:Name="SettingsIcon"
                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Fill="{DynamicResource PrimaryBrush}"
                          Stretch="Uniform"
                          Width="24"
                          Height="24"/>
                        <!-- 设置按钮 -->
                        <TextBlock Text="{DynamicResource Nav_Settings}" Foreground="{DynamicResource ForegroundBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 收藏 -->
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,0" Height="60"
                        Click="FavoritesNavButton_Click">
                    <StackPanel>
                        <Path x:Name="FavoritesIcon"
                          Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                          Fill="{DynamicResource ForegroundBrush}"
                          Stretch="Uniform"
                          Width="24"
                          Height="24"/>
                        <!-- 收藏按钮 -->
                        <TextBlock Text="{DynamicResource Nav_Favorites}" Foreground="{DynamicResource ForegroundBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 关联 -->
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,0" Height="60"
                        Click="AssociationsNavButton_Click">
                    <StackPanel>
                        <Path x:Name="AssociationsIcon"
                          Data="M3.9,12A5,5 0 0,1 8.9,7H12V9H8.9A3,3 0 0,0 8.9,15H12V17H8.9A5,5 0 0,1 3.9,12M15.1,7A5,5 0 0,1 20.1,12A5,5 0 0,1 15.1,17H12V15H15.1A3,3 0 0,0 15.1,9H12V7H15.1Z"
                          Fill="{DynamicResource ForegroundBrush}"
                          Stretch="Uniform"
                          Width="24"
                          Height="24"/>
                        <!-- 关联按钮 -->
                        <TextBlock Text="{DynamicResource Nav_Associations}" Foreground="{DynamicResource ForegroundBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <!-- 右侧内容区域 - 灰黑色背景 -->
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundMediumBrush}" Margin="0,0,0,0">
            <!-- 标题栏 -->
            <Grid Height="50" VerticalAlignment="Top" Background="{DynamicResource BackgroundDarkBrush}">
                <TextBlock x:Name="PageTitleText" 
                   Text="{DynamicResource Page_GeneralSettings}" 
                   Foreground="{DynamicResource ForegroundBrush}" 
                   FontSize="18" 
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" 
                   Margin="20,0,0,0"/>

                <!-- 关闭按钮 -->
                <Button Background="Transparent" 
                BorderThickness="0" 
                Width="40" 
                Height="40"
                HorizontalAlignment="Right" 
                Margin="0,0,10,0"
                Click="CloseButton_Click">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                  Fill="{DynamicResource ForegroundBrush}"
                  Stretch="Uniform"
                  Width="16"
                  Height="16"/>
                </Button>
            </Grid>

            <!-- 设置页 -->
            <Grid x:Name="SettingsPage" Margin="0,50,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="20,20,20,0">
                    <StackPanel Margin="0,0,40,0">
                        <!-- 设置页标题区域 - 渐变背景 -->
                        <Border Background="{DynamicResource HeaderGradientBrush}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                           
                                <Ellipse Fill="#14FFFFFF"
                                         Width="140"
                                         Height="140"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,-80,-70"
                                         IsHitTestVisible="False"/>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Page_GeneralSettings}" 
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Settings_HeaderSubtitle}" 
                                               Foreground="#CCFFFFFF"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 基本设置卡片 -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_DefaultViewMode}"
                                        Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ViewModeComboBox" Margin="0,4">
                                    <ComboBoxItem Content="{DynamicResource ViewMode_Single}" Tag="{x:Static models:ViewMode.Single}"/>
                                    <ComboBoxItem Content="{DynamicResource ViewMode_Manga}" Tag="{x:Static models:ViewMode.Manga}"/>
                                    <ComboBoxItem Content="{DynamicResource ViewMode_DoublePage}"  Tag="{x:Static models:ViewMode.DoublePage}"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_Theme}"
                                        Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ThemeComboBox" Margin="0,12,0,4">
                                    <ComboBoxItem Content="{DynamicResource Theme_Dark}" Tag="{x:Static models:AppTheme.Dark}"/>
                                    <ComboBoxItem Content="{DynamicResource Theme_Light}" Tag="{x:Static models:AppTheme.Light}"/>
                                    <ComboBoxItem Content="{DynamicResource Theme_SoftPink}" Tag="{x:Static models:AppTheme.SoftPink}"/>
                                    <ComboBoxItem Content="{DynamicResource Theme_HotRed}" Tag="{x:Static models:AppTheme.HotRed}"/>
                                    <ComboBoxItem Content="{DynamicResource Theme_Ocean}" Tag="{x:Static models:AppTheme.Ocean}"/>
                                    <ComboBoxItem Content="{DynamicResource Theme_Forest}" Tag="{x:Static models:AppTheme.Forest}"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_Language}"
        Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LanguageComboBox" Margin="0,12,0,4">
                                    <ComboBoxItem Content="{DynamicResource Language_Chinese}" Tag="{x:Static models:AppLanguage.ChineseSimplified}"/>
                                    <ComboBoxItem Content="{DynamicResource Language_English}" Tag="{x:Static models:AppLanguage.English}"/>
                                </ComboBox>


                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_ScrollWheel}"
                                        Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ScrollWheelComboBox" Margin="0,12,0,4">
                                    <ComboBoxItem Content="{DynamicResource ScrollWheel_Zoom}" Tag="{x:Static models:ScrollWheelBehavior.Zoom}"/>
                                    <ComboBoxItem Content="{DynamicResource ScrollWheel_Navigate}" Tag="{x:Static models:ScrollWheelBehavior.Navigate}"/>
                                </ComboBox>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Settings_MapProvider}"
                                        Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="MapProviderComboBox" Margin="0,12,0,4">
                                    <ComboBoxItem Content="{DynamicResource MapProvider_Amap}" Tag="{x:Static models:MapProvider.Amap}"/>
                                    <ComboBoxItem Content="{DynamicResource MapProvider_Google}" Tag="{x:Static models:MapProvider.Google}"/>
                                </ComboBox>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Settings_SingleBarLayout}"
                                        Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="SingleBarLayoutComboBox" Margin="0,12,0,4">
                                    <ComboBoxItem Content="{DynamicResource SingleDoubleBarLayout_Bottom}" Tag="{x:Static models:SingleDoubleBarLayout.Bottom}"/>
                                    <ComboBoxItem Content="{DynamicResource SingleDoubleBarLayout_Side}" Tag="{x:Static models:SingleDoubleBarLayout.Side}"/>
                                </ComboBox>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Settings_DoubleBarLayout}"
                                        Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="DoubleBarLayoutComboBox" Margin="0,12,0,4">
                                    <ComboBoxItem Content="{DynamicResource SingleDoubleBarLayout_Bottom}" Tag="{x:Static models:SingleDoubleBarLayout.Bottom}"/>
                                    <ComboBoxItem Content="{DynamicResource SingleDoubleBarLayout_Side}" Tag="{x:Static models:SingleDoubleBarLayout.Side}"/>
                                </ComboBox>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Settings_MangaGap}"
                              Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Slider x:Name="MangaGapSlider" Width="150" Minimum="0" Maximum="30"
                         Value="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock x:Name="MangaGapText" Text="4" Foreground="{DynamicResource ForegroundBrush}"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Slideshow Settings -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_SlideshowTitle}" Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_SlideshowInterval}"
                                                    Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Slider x:Name="IntervalSlider" Width="150" Minimum="1" Maximum="30"
                                                     Value="5" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="IntervalText" Text="5" Foreground="{DynamicResource ForegroundBrush}"
                                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_SlideshowShuffle}"
                                                    Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ShuffleSlideshowCheckBox" Content="{DynamicResource Settings_ShuffleEnabled}"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,12,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Performance Settings -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_PerformanceTitle}" Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_PreloadCount}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Slider x:Name="PreloadSlider" Width="150" Minimum="1" Maximum="10"
                                                    Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="PreloadText" Text="3" Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_ThumbnailSize}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Slider x:Name="ThumbnailSlider" Width="150" Minimum="40" Maximum="240"
                                                    Value="120" TickFrequency="20" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="ThumbnailText" Text="120" Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>


                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_MangaDecodeWidth}" Visibility="Hidden"
                                                    Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Hidden">
                                        <Slider x:Name="MangaDecodeSlider" Width="150" Minimum="800" Maximum="4000"
                                                     Value="1600" TickFrequency="200" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="MangaDecodeText" Text="1600" Foreground="{DynamicResource ForegroundBrush}"
                                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_ArchiveStrategy}"
                                                    Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ArchiveStrategyComboBox" Margin="0,12,40,0">
                                        <ComboBoxItem Content="{DynamicResource Archive_Stream}" Tag="{x:Static models:ArchiveLoadStrategy.Stream}"/>
                                        <ComboBoxItem Content="{DynamicResource Archive_TempExtract}" Tag="{x:Static models:ArchiveLoadStrategy.TempExtractLru}"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Filter Settings -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_FilterTitle}" Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Settings_FilterHint}"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               FontSize="12" Margin="0,0,0,12"/>

                                <CheckBox x:Name="EnableFiltersCheckBox" Content="{DynamicResource Settings_EnableFilters}"
                                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>

                                <CheckBox x:Name="SizeFilterCheckBox" Content="{DynamicResource Settings_SizeFilter}"
                                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,12,0,4"/>
                                <Grid Margin="24,0,0,0"
                                          IsEnabled="{Binding IsChecked, ElementName=SizeFilterCheckBox}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_MinWidth}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinWidthTextBox"
                                                 Width="120" Height="28" Margin="0,6,0,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_MinHeight}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinHeightTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_MaxWidth}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxWidthTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_MaxHeight}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxHeightTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>
                                </Grid>

                                <CheckBox x:Name="FileSizeFilterCheckBox" Content="{DynamicResource Settings_FileSizeFilter}"
                                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,16,0,4"/>
                                <Grid Margin="24,0,0,0"
                                          IsEnabled="{Binding IsChecked, ElementName=FileSizeFilterCheckBox}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_MinFileSize}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinFileSizeTextBox"
                                                 Width="120" Height="28" Margin="0,6,0,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_MaxFileSize}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaxFileSizeTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Behavior Settings -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_BehaviorTitle}" Foreground="{DynamicResource ForegroundBrush}"
                                                FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <CheckBox x:Name="RememberPositionCheckBox" Content="{DynamicResource Settings_RememberPosition}"
                                               Foreground="{DynamicResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="RememberReadingCheckBox" Content="{DynamicResource Settings_RememberReading}"
                                               Foreground="{DynamicResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="FreezeDuringResizeCheckBox" Content="{DynamicResource Settings_FreezeDuringResize}"
                                                Foreground="{DynamicResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="ShowStatusBarCheckBox" Content="{DynamicResource Settings_ShowStatusBar}"
                                                Foreground="{DynamicResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>

                                <CheckBox x:Name="ScanSubfoldersCheckBox" Content="{DynamicResource Settings_ScanSubfolders}"
                                                Foreground="{DynamicResource ForegroundBrush}" IsChecked="False" Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                                    <TextBlock Text="{DynamicResource Settings_ScanDepth}" Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ScanSubfoldersDepthComboBox" Width="120" Margin="12,0,0,0"
                                                    IsEnabled="{Binding IsChecked, ElementName=ScanSubfoldersCheckBox}">
                                        <ComboBoxItem Content="{DynamicResource ScanDepth_Current}" Tag="0"/>
                                        <ComboBoxItem Content="1" Tag="1"/>
                                        <ComboBoxItem Content="2" Tag="2"/>
                                        <ComboBoxItem Content="3" Tag="3"/>
                                        <ComboBoxItem Content="{DynamicResource ScanDepth_Infinite}"  Tag="-1"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- LocalSend -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_LocalSendTitle}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_LocalSendPath}" Width="100"
                                                   Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox x:Name="LocalSendPathTextBox" Width="200" Height="30"
                                                     IsReadOnly="True" VerticalContentAlignment="Center"/>
                                        <Button Content="{DynamicResource Button_Browse}" Style="{StaticResource ModernButtonStyle}" Margin="8,0,0,0"
                                                    Click="BrowseLocalSendButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 版本更新和交流 - 使用主题渐变色 -->
                        <Border Background="{DynamicResource HeaderGradientBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_AboutTitle}" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_CurrentVersion}"  VerticalAlignment="Center" FontWeight="Medium" Foreground="#CCFFFFFF"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion, StringFormat=v{0}}" VerticalAlignment="Center" Foreground="White"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_Website}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,12,0,0" Foreground="#CCFFFFFF"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="{DynamicResource Button_OpenWebsite}"
                                                HorizontalAlignment="Left"
                                                Width="200"
                                                Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                                                Click="OpenWebsite_Click"
                                                ToolTip="{DynamicResource ToolTip_OpenWebsite}"
                                                Margin="0,12,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <!-- 底部按钮 -->
                <Border Grid.Row="1" Margin="20,8,20,20" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Button_Cancel}" Style="{StaticResource ModernButtonStyle}"
                                  Click="CancelButton_Click" Width="80" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Button_Save}" Style="{StaticResource ModernButtonStyle}"
                                  Click="SaveButton_Click" Width="80"/>
                    </StackPanel>
                </Border>
            </Grid>


            <!-- 收藏页 -->
            <Grid x:Name="FavoritesPage" Visibility="Collapsed" Margin="0,50,0,0" ClipToBounds="True">
                <Grid Margin="20">
                    <Grid.Resources>
                        <Style x:Key="FavoritePillStyle" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
                            <Setter Property="CornerRadius" Value="999"/>
                            <Setter Property="Padding" Value="10,4"/>
                        </Style>
                        <DataTemplate x:Key="FavoriteImageItemTemplate">
                            <Border Background="{DynamicResource BackgroundMediumBrush}"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,12,12"
                                    Width="210"
                                    ToolTip="{Binding DisplayPath}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="4">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <Border Background="#80000000"
                                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource Status_Loading}" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <Border Background="#80000000">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                                                    <Condition Binding="{Binding Exists}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{DynamicResource Status_NoPreview}" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <Border Background="#80000000"
                                                    Visibility="{Binding Exists, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                <TextBlock Text="{DynamicResource Status_FileNotExists}" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <CheckBox HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Margin="6"
                                                      IsChecked="{Binding IsSelected}"
                                                      Visibility="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="12"
                                               Margin="0,8,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="{DynamicResource Button_Open}" Style="{StaticResource ModernButtonStyle}" Padding="8,4" Margin="0,0,6,0"
                                                IsEnabled="{Binding Exists}"
                                                Click="OpenFavoriteInViewer_Click"/>
                                        <Button Content="{DynamicResource Button_Locate}" Style="{StaticResource ModernButtonStyle}" Padding="8,4" Margin="0,0,6,0"
                                                IsEnabled="{Binding Exists}"
                                                Click="OpenFavoriteInExplorer_Click"/>
                                        <Button Content="{DynamicResource Button_Unfavorite}" Style="{StaticResource ModernButtonStyle}" Padding="8,4"
                                                Click="RemoveFavorite_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="FavoriteFolderImageItemTemplate">
                            <Border Background="{DynamicResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="6"
                                    Margin="0,0,0,6"
                                    ToolTip="{Binding DisplayPath}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BackgroundMediumBrush}" CornerRadius="3" Width="48" Height="36">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Button_Open}" Style="{StaticResource ModernButtonStyle}" Padding="6,3" Margin="0,0,6,0"
                                                IsEnabled="{Binding Exists}"
                                                Click="OpenFavoriteInViewer_Click"/>
                                        <Button Content="{DynamicResource Button_Locate}" Style="{StaticResource ModernButtonStyle}" Padding="6,3" Margin="0,0,6,0"
                                                IsEnabled="{Binding Exists}"
                                                Click="OpenFavoriteInExplorer_Click"/>
                                        <Button Content="{DynamicResource Button_Remove}" Style="{StaticResource ModernButtonStyle}" Padding="6,3"
                                                Click="RemoveFavorite_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="FavoriteFolderItemTemplate">
                            <Border Background="{DynamicResource BackgroundMediumBrush}"
                                    BorderBrush="{DynamicResource BackgroundLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,12,12"
                                    Width="260"
                                    ToolTip="{Binding FolderPath}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource BackgroundDarkBrush}"
                                                CornerRadius="6"
                                                Padding="6"
                                                Margin="0,0,8,0">
                                            <Path Data="M4 4 L10 4 L12 6 L20 6 L20 10 M2 10 L22 10 L20 20 L4 20 L2 10 z"
                                                  Stroke="{DynamicResource ForegroundBrush}"
                                                  StrokeThickness="2"
                                                  Width="16" Height="16"
                                                  Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FolderPath}"
                                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Padding="6,2"
                                                Margin="0,0,0,0"
                                                Click="ToggleFavoriteFolderExpanded_Click"
                                                ToolTip="{DynamicResource Button_ExpandCollapseNote}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource Button_Collapse}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                <Setter Property="Text" Value="{DynamicResource Button_Expand}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <CheckBox Grid.Column="3"
                                                  Margin="8,0,0,0"
                                                  IsChecked="{Binding IsSelected}"
                                                  Visibility="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource FavoritePillStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource Favorites_FavoriteCount}" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="10" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding FavoriteImageCount}"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource AccentBrush}"
                                                CornerRadius="999"
                                                Padding="8,2"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding Exists, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                            <TextBlock Text="{DynamicResource Favorites_InvalidPath}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Button_Open}" Style="{StaticResource ModernButtonStyle}" Padding="8,4" Margin="0,0,6,0"
                                                IsEnabled="{Binding Exists}"
                                                Click="OpenFavoriteFolderInViewer_Click"/>
                                        <Button Content="{DynamicResource Button_Locate}" Style="{StaticResource ModernButtonStyle}" Padding="8,4" Margin="0,0,6,0"
                                                IsEnabled="{Binding Exists}"
                                                Click="OpenFavoriteFolderInExplorer_Click"/>
                                        <Button Content="{DynamicResource Button_Remove}" Style="{StaticResource ModernButtonStyle}" Padding="8,4"
                                                Click="RemoveFavoriteFolder_Click"/>
                                    </StackPanel>

                                    <Border Grid.Row="3"
                                            Background="{DynamicResource BackgroundDarkBrush}"
                                            CornerRadius="4"
                                            Padding="6"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Favorites_NoImages}"
                                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,0,6">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Images.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ScrollViewer MaxHeight="220"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Images}"
                                                              ItemTemplate="{StaticResource FavoriteFolderImageItemTemplate}"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </Grid.Resources>
                    <Grid>
                        <Grid x:Name="FavoriteFoldersPanel">
                            <Grid x:Name="FavoriteFoldersListPanel" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource HeaderGradientBrush}"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Ellipse Fill="#22FFFFFF"
                                                 Width="180"
                                                 Height="180"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Margin="0,-80,-60,0"
                                                 IsHitTestVisible="False"/>
                                        <Ellipse Fill="#14FFFFFF"
                                                 Width="140"
                                                 Height="140"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,0,-80,-70"
                                                 IsHitTestVisible="False"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                 
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource Favorites_FoldersTitle}"
                                                                   Foreground="White"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource Favorites_FoldersHint}"
                                                                   Foreground="#CCFFFFFF"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource FavoritePillStyle}" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource Favorites_Folders}" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FavoriteFolderItems.Count}"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                             
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource BackgroundMediumBrush}"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Favorites_Sort}" Foreground="{DynamicResource ForegroundDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="FavoriteFolderSortComboBox" Width="140"   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      SelectionChanged="FavoriteFolderSort_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Favorites_SortByTime}" Tag="AddedAt" IsSelected="True"/>
                                                <ComboBoxItem Content="{DynamicResource Favorites_SortByName}" Tag="Name"/>
                                            </ComboBox>
                                            <Border Background="{DynamicResource BackgroundLightBrush}" Width="1" Height="18" Margin="12,0" Opacity="0.6"/>
                                            <Button Content="{DynamicResource Button_AddFolder}" Style="{StaticResource ModernButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                                                    Click="AddFavoriteFolder_Click"/>
                                            <Button Content="{DynamicResource Button_AddCurrentFolder}" Style="{StaticResource ModernButtonStyle}" Padding="10,6"
                                                    Click="AddCurrentFolder_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="FavoriteFoldersBatchToggle" Content="{DynamicResource Favorites_BatchRemove}" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource ForegroundDimBrush}"
                                                      Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Button_RemoveSelected}" Style="{StaticResource ModernButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                                                    IsEnabled="{Binding ElementName=FavoriteFoldersBatchToggle, Path=IsChecked}"
                                                    Click="RemoveSelectedFavoriteFolders_Click"/>
                                            <Button Content="{DynamicResource Button_Clear}" Style="{StaticResource ModernButtonStyle}" Padding="10,6"
                                                    Click="ClearFavoriteFolders_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=FavoriteFoldersItemsControl, Path=HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                            <Path Data="M4 4 L10 4 L12 6 L20 6 L20 10 M2 10 L22 10 L20 20 L4 20 L2 10 z"
                                                  Stroke="{DynamicResource ForegroundBrush}"
                                                  StrokeThickness="2"
                                                  Width="26" Height="26"
                                                  Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Favorites_NoFolders}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Favorites_NoFoldersHint}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="FavoriteFoldersItemsControl"
                                                      ItemsSource="{Binding FavoriteFolderItems}"
                                                      ItemTemplate="{StaticResource FavoriteFolderItemTemplate}"
                                                      Tag="{Binding ElementName=FavoriteFoldersBatchToggle}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <Grid x:Name="FavoriteFolderImagesPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Button_Back}" Style="{StaticResource ModernButtonStyle}" Padding="10,6"
                                            Click="BackToFavoriteFolders_Click"/>
                                    <TextBlock x:Name="FavoriteFolderImagesTitle"
                                               Text="{DynamicResource Favorites_FoldersTitle}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="13"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Favorites_ItemCountPrefix}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                                        <TextBlock Text="{Binding FavoriteFolderImageItems.Count}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                                        <TextBlock Text="{DynamicResource Favorites_ItemCountSuffix}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <TextBlock Text="{DynamicResource Favorites_NoImagesInFolder}"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=FavoriteFolderImagesItemsControl, Path=HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="FavoriteFolderImagesItemsControl"
                                                      ItemsSource="{Binding FavoriteFolderImageItems}"
                                                      ItemTemplate="{StaticResource FavoriteImageItemTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 关联页 -->
            <Grid x:Name="AssociationsPage" Visibility="Collapsed" Margin="0,50,0,0">
                <Grid.Resources>
                    <Style x:Key="AssociationPillStyle" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
                        <Setter Property="CornerRadius" Value="999"/>
                        <Setter Property="Padding" Value="10,4"/>
                    </Style>
                </Grid.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Background="{DynamicResource HeaderGradientBrush}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Ellipse Fill="#22FFFFFF"
                                         Width="180"
                                         Height="180"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-80,-60,0"/>
                                <Ellipse Fill="#18FFFFFF"
                                         Width="130"
                                         Height="130"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,-70,-60"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Associations_Title}"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Associations_Subtitle}"
                                                   Foreground="#CCFFFFFF"
                                                   FontSize="11"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource AssociationPillStyle}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Associations_Normal}" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AssociationNormalOptions.Count}"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource AssociationPillStyle}">
                                            <StackPanel>
                                                <TextBlock Text="RAW" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AssociationRawOptions.Count}"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Associations_NoteTitle}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Associations_Note1}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="{DynamicResource Associations_Note2}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Associations_FormatSelect}" Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Style="{StaticResource AssociationPillStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Associations_TotalPrefix}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding AssociationOptions.Count}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{DynamicResource Associations_TotalSuffix}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Button_SelectAll}" Style="{StaticResource ModernButtonStyle}" Width="auto" Margin="0,0,8,0"
                                            Click="SelectAllAssociations_Click"/>
                                    <Button Content="{DynamicResource Button_DeselectAll}" Style="{StaticResource ModernButtonStyle}" Width="auto"
                                            Click="ClearAllAssociations_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Associations_NormalFormats}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0"/>
                                    <Border Style="{StaticResource AssociationPillStyle}">
                                        <TextBlock Text="{Binding AssociationNormalOptions.Count}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding AssociationNormalOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Foreground="{DynamicResource ForegroundBrush}"
                                                      Margin="0,0,12,8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Associations_RawFormats}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0"/>
                                    <Border Style="{StaticResource AssociationPillStyle}">
                                        <TextBlock Text="{Binding AssociationRawOptions.Count}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding AssociationRawOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Foreground="{DynamicResource ForegroundBrush}"
                                                      Margin="0,0,12,8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ApplyAssociationsButton"
                                Content="{DynamicResource Button_ApplyAssociations}"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="ApplyAssociationsButton_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>

</Window>
