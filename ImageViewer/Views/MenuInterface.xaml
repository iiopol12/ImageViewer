<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="600" Width="800"
        Background="#FF1A1A1A">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧按钮栏 - 黑色背景 -->
        <StackPanel Grid.Column="0" Background="#FF000000" VerticalAlignment="Top" Margin="0,40,0,0">
            
            <!-- 设置图标按钮 -->
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,20,0,0" Height="60">
                <StackPanel>
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                          Fill="#FF4A9EFF" 
                          Stretch="Uniform" 
                          Width="24" 
                          Height="24"/>
                    <TextBlock Text="设置" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>

            <!-- 收藏图标按钮 -->
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,20,0,0" Height="60">
                <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" 
                      Fill="White" 
                      Stretch="Uniform" 
                      Width="24" 
                      Height="24"/>
            </Button>

            <!-- 删除图标按钮 -->
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,20,0,0" Height="60">
                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                      Fill="White" 
                      Stretch="Uniform" 
                      Width="24" 
                      Height="24"/>
            </Button>

        </StackPanel>

        <!-- 右侧内容区域 - 灰黑色背景 -->
        <StackPanel Grid.Column="1" Background="#FF2A2A2A" Margin="20,40,20,20">

            <!-- 第一个选项 - 请求删除照片的权限 -->
            <Border Background="#FF3A3A3A" 
                    CornerRadius="8" 
                    Padding="20,15" 
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Path Grid.Column="0" 
                          Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                          Fill="#FF4A9EFF" 
                          Stretch="Uniform" 
                          Width="28" 
                          Height="28"
                          VerticalAlignment="Center"/>

                    <!-- 文本内容 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="请求删除照片的权限" 
                                   Foreground="White" 
                                   FontSize="16" 
                                   FontWeight="Medium"/>
                        <TextBlock Text="删除项目或文件夹的显示确认对话框" 
                                   Foreground="#FFB0B0B0" 
                                   FontSize="13" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 右侧箭头 -->
                    <Path Grid.Column="2" 
                          Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                          Fill="#FF808080" 
                          Stretch="Uniform" 
                          Width="20" 
                          Height="20"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 第二个选项 - 默认打开方式 -->
            <Border Background="#FF3A3A3A" 
                    CornerRadius="8" 
                    Padding="20,15" 
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Viewbox Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                        <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z" 
                              Fill="White" 
                              Stretch="Uniform"/>
                    </Viewbox>

                    <!-- 文本内容 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="默认打开方式" 
                                   Foreground="White" 
                                   FontSize="16" 
                                   FontWeight="Medium"/>
                        <TextBlock Text="打启后将设置为本地图片的默认打开方式" 
                                   Foreground="#FFB0B0B0" 
                                   FontSize="13" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 第三个选项 - 同步展示网盘图片 -->

        </StackPanel>
    </Grid>

    <!-- 样式资源 -->
    <Window.Resources>
        <!-- 切换开关样式 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBackground" 
                                    Width="50" 
                                    Height="26" 
                                    CornerRadius="13" 
                                    Background="#FF666666"/>
                            <Border x:Name="SwitchThumb" 
                                    Width="22" 
                                    Height="22" 
                                    CornerRadius="11" 
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBackground" Property="Background" Value="#FF4A9EFF"/>
                                <Setter TargetName="ThumbTransform" Property="X" Value="24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

</Window>
