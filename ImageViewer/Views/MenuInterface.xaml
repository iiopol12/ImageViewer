<Window x:Class="ImageViewer.Views.MenuInterface"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ImageViewer.Models"
        Title="设置" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="#FF1A1A1A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧按钮栏 - 黑色背景 -->
        <Grid Grid.Column="0" Background="#FF1E1E1E">
            <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">

                <!-- 设置 -->
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,0" Height="60"
                        Click="SettingsNavButton_Click">
                    <StackPanel>
                        <Path x:Name="SettingsIcon"
                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Fill="#FF4A9EFF"
                          Stretch="Uniform"
                          Width="24"
                          Height="24"/>
                        <TextBlock Text="设置" Foreground="White" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 收藏 -->
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,0" Height="60"
                        Click="FavoritesNavButton_Click">
                    <StackPanel>
                        <Path x:Name="FavoritesIcon"
                          Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                          Fill="White"
                          Stretch="Uniform"
                          Width="24"
                          Height="24"/>
                        <TextBlock Text="收藏" Foreground="White" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 关联 -->
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,0" Height="60"
                        Click="AssociationsNavButton_Click">
                    <StackPanel>
                        <Path x:Name="AssociationsIcon"
                          Data="M3.9,12A5,5 0 0,1 8.9,7H12V9H8.9A3,3 0 0,0 8.9,15H12V17H8.9A5,5 0 0,1 3.9,12M15.1,7A5,5 0 0,1 20.1,12A5,5 0 0,1 15.1,17H12V15H15.1A3,3 0 0,0 15.1,9H12V7H15.1Z"
                          Fill="White"
                          Stretch="Uniform"
                          Width="24"
                          Height="24"/>
                        <TextBlock Text="关联" Foreground="White" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <!-- 右侧内容区域 - 灰黑色背景 -->
        <Grid Grid.Column="1" Background="#FF2A2A2A" Margin="0,0,0,0">
            <!-- 标题栏 -->
            <Grid Height="50" VerticalAlignment="Top" Background="#FF1E1E1E">
                <TextBlock x:Name="PageTitleText" 
                   Text="常规设置" 
                   Foreground="White" 
                   FontSize="18" 
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" 
                   Margin="20,0,0,0"/>

                <!-- 关闭按钮 -->
                <Button Background="Transparent" 
                BorderThickness="0" 
                Width="40" 
                Height="40"
                HorizontalAlignment="Right" 
                Margin="0,0,10,0"
                Click="CloseButton_Click">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                  Fill="White"
                  Stretch="Uniform"
                  Width="16"
                  Height="16"/>
                </Button>
            </Grid>

            <!-- 设置页 -->
            <Grid x:Name="SettingsPage" Margin="0,50,0,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        

                             <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="6" Padding="12" Margin="0,0,40,16">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="150"/>
                                         <ColumnDefinition Width="*"/>
                                     </Grid.ColumnDefinitions>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                     <TextBlock Grid.Row="0" Grid.Column="0" Text="默认浏览模式"
                                                Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                     <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ViewModeComboBox" Margin="0,4">
                                         <ComboBoxItem Content="单图模式" Tag="{x:Static models:ViewMode.Single}"/>
                                         <ComboBoxItem Content="漫画模式" Tag="{x:Static models:ViewMode.Manga}"/>
                                         <ComboBoxItem Content="双页模式" Tag="{x:Static models:ViewMode.DoublePage}"/>
                                     </ComboBox>

                                     <TextBlock Grid.Row="1" Grid.Column="0" Text="背景颜色"
                                                Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                     <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BackgroundComboBox" Margin="0,12,0,4">
                                         <ComboBoxItem Content="黑色" Tag="{x:Static models:BackgroundColor.Black}"/>
                                         <ComboBoxItem Content="白色" Tag="{x:Static models:BackgroundColor.White}"/>
                                         <ComboBoxItem Content="灰色" Tag="{x:Static models:BackgroundColor.Gray}"/>
                                         <ComboBoxItem Content="深灰" Tag="{x:Static models:BackgroundColor.DarkGray}"/>
                                   
                                     </ComboBox>

                                     <TextBlock Grid.Row="2" Grid.Column="0" Text="滚轮行为"
                                                Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                     <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ScrollWheelComboBox" Margin="0,12,0,4">
                                         <ComboBoxItem Content="缩放" Tag="{x:Static models:ScrollWheelBehavior.Zoom}"/>
                                         <ComboBoxItem Content="翻页" Tag="{x:Static models:ScrollWheelBehavior.Navigate}"/>
                                     </ComboBox>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="漫画模式间隔(px)"
                                      Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Slider x:Name="MangaGapSlider" Width="150" Minimum="0" Maximum="30"
                                 Value="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="MangaGapText" Text="4" Foreground="{StaticResource ForegroundBrush}"
                                     VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>

                                </Grid>
                             </Border>

                            <!-- Slideshow Settings -->
                            <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="幻灯片设置" Foreground="{StaticResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="150"/>
                                             <ColumnDefinition Width="*"/>
                                         </Grid.ColumnDefinitions>
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto"/>
                                             <RowDefinition Height="Auto"/>
                                         </Grid.RowDefinitions>
 
                                         <TextBlock Grid.Row="0" Grid.Column="0" Text="切换间隔(秒)"
                                                    Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                         <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                             <Slider x:Name="IntervalSlider" Width="150" Minimum="1" Maximum="30"
                                                     Value="5" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                             <TextBlock x:Name="IntervalText" Text="5" Foreground="{StaticResource ForegroundBrush}"
                                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                         </StackPanel>

                                         <TextBlock Grid.Row="1" Grid.Column="0" Text="随机播放"
                                                    Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                         <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ShuffleSlideshowCheckBox" Content="启用随机（单图模式）"
                                                   Foreground="{StaticResource ForegroundBrush}" Margin="0,12,0,0"/>
                                     </Grid>
                                 </StackPanel>
                             </Border>

                            <!-- Performance Settings -->
                            <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="性能设置" Foreground="{StaticResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                     </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="预加载数量"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                            <Slider x:Name="PreloadSlider" Width="150" Minimum="1" Maximum="10"
                                                    Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                            <TextBlock x:Name="PreloadText" Text="3" Foreground="{StaticResource ForegroundBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="缩略图大小(px)"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                            <Slider x:Name="ThumbnailSlider" Width="150" Minimum="40" Maximum="240"
                                                    Value="120" TickFrequency="20" IsSnapToTickEnabled="True"/>
                                            <TextBlock x:Name="ThumbnailText" Text="120" Foreground="{StaticResource ForegroundBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>

                                      
                                         <TextBlock Grid.Row="2" Grid.Column="0" Text="漫画解码宽度(px)" Visibility="Hidden"
                                                    Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                         <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Hidden">
                                             <Slider x:Name="MangaDecodeSlider" Width="150" Minimum="800" Maximum="4000"
                                                     Value="1600" TickFrequency="200" IsSnapToTickEnabled="True"/>
                                             <TextBlock x:Name="MangaDecodeText" Text="1600" Foreground="{StaticResource ForegroundBrush}"
                                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                         </StackPanel>

                                         <TextBlock Grid.Row="3" Grid.Column="0" Text="压缩包读取"
                                                    Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                         <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ArchiveStrategyComboBox" Margin="0,12,40,0">
                                             <ComboBoxItem Content="内存流（默认）" Tag="{x:Static models:ArchiveLoadStrategy.Stream}"/>
                                             <ComboBoxItem Content="解压到临时目录" Tag="{x:Static models:ArchiveLoadStrategy.TempExtractLru}"/>
                                         </ComboBox>
                                     </Grid>
                                 </StackPanel>
                             </Border>

                            <!-- Filter Settings -->
                            <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="过滤设置" Foreground="{StaticResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="0 表示不限制，快捷键 Ctrl+Shift+F 启用/关闭过滤"
                                               Foreground="{StaticResource ForegroundDimBrush}"
                                               FontSize="12" Margin="0,0,0,12"/>

                                    <CheckBox x:Name="EnableFiltersCheckBox" Content="启用过滤（仅对文件夹生效）"
                                              Foreground="{StaticResource ForegroundBrush}" Margin="0,4"/>

                                    <CheckBox x:Name="SizeFilterCheckBox" Content="启用尺寸过滤"
                                              Foreground="{StaticResource ForegroundBrush}" Margin="0,12,0,4"/>
                                    <Grid Margin="24,0,0,0"
                                          IsEnabled="{Binding IsChecked, ElementName=SizeFilterCheckBox}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最小宽度"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinWidthTextBox"
                                                 Width="120" Height="28" Margin="0,6,0,0" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最小高度"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinHeightTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="最大宽度"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxWidthTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="最大高度"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxHeightTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <CheckBox x:Name="FileSizeFilterCheckBox" Content="启用文件大小过滤"
                                              Foreground="{StaticResource ForegroundBrush}" Margin="0,16,0,4"/>
                                    <Grid Margin="24,0,0,0"
                                          IsEnabled="{Binding IsChecked, ElementName=FileSizeFilterCheckBox}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最小大小(KB)"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinFileSizeTextBox"
                                                 Width="120" Height="28" Margin="0,6,0,0" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最大大小(MB)"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaxFileSizeTextBox"
                                                 Width="120" Height="28" Margin="0,12,0,0" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Behavior Settings -->
                             <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                 <StackPanel>
                                     <TextBlock Text="行为设置" Foreground="{StaticResource ForegroundBrush}"
                                                FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
 
                                     <CheckBox x:Name="RememberPositionCheckBox" Content="记住窗口位置和大小"
                                               Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                     <CheckBox x:Name="RememberReadingCheckBox" Content="记住上次阅读位置"
                                               Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                      <CheckBox x:Name="FreezeDuringResizeCheckBox" Content="拖动缩放时冻结界面（减少抖动）"
                                                Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                      <CheckBox x:Name="ShowStatusBarCheckBox" Content="显示底边栏（状态栏）"
                                                Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>

                                      <CheckBox x:Name="ScanSubfoldersCheckBox" Content="启用穿透子文件夹（包含子目录图片）"
                                                Foreground="{StaticResource ForegroundBrush}" IsChecked="False" Margin="0,12,0,4"/>
                                      <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                                          <TextBlock Text="穿透层数" Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"/>
                                          <ComboBox x:Name="ScanSubfoldersDepthComboBox" Width="120" Margin="12,0,0,0"
                                                    IsEnabled="{Binding IsChecked, ElementName=ScanSubfoldersCheckBox}">
                                              <ComboBoxItem Content="0（仅当前）" Tag="0"/>
                                              <ComboBoxItem Content="1" Tag="1"/>
                                              <ComboBoxItem Content="2" Tag="2"/>
                                              <ComboBoxItem Content="3" Tag="3"/>
                                              <ComboBoxItem Content="无限" Tag="-1"/>
                                          </ComboBox>
                                      </StackPanel>
                                  </StackPanel>
                              </Border>

                            <!-- LocalSend -->
                            <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="LocalSend 分享设置" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="可执行文件路径" Width="100"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBox x:Name="LocalSendPathTextBox" Width="200" Height="30"
                                                     IsReadOnly="True" VerticalContentAlignment="Center"/>
                                            <Button Content="浏览..." Style="{StaticResource ModernButtonStyle}" Margin="8,0,0,0"
                                                    Click="BrowseLocalSendButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- 版本更新和交流 -->
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="20" Margin="0,16,0,15">
                                <StackPanel>
                                    <TextBlock Text="版本更新和交流" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本：" VerticalAlignment="Center" FontWeight="Medium"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion, StringFormat=v{0}}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="交流地址：" VerticalAlignment="Center" FontWeight="Medium" Margin="0,12,0,0"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="打开网址"
                                                HorizontalAlignment="Left"
                                                Width="200"
                                                Background="#2196F3" Foreground="White" BorderThickness="0"
                                                Click="OpenWebsite_Click"
                                                ToolTip="在默认浏览器中打开网站"
                                                Margin="0,12,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                         </StackPanel>
                     </ScrollViewer>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="取消" Style="{StaticResource ModernButtonStyle}"
                                Click="CancelButton_Click" Width="80" Margin="0,0,8,0"/>
                        <Button Content="保存" Style="{StaticResource ModernButtonStyle}"
                                Click="SaveButton_Click" Width="80" Margin="0,0,40,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 收藏页（占位） -->
            <Grid x:Name="FavoritesPage" Visibility="Collapsed" Margin="0,50,0,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding FavoriteItems.Count, StringFormat=共 {0} 项}"
                               Foreground="{StaticResource ForegroundDimBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <TextBlock Text="暂无收藏"
                                   Foreground="{StaticResource ForegroundDimBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=FavoritesItemsControl, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FavoritesItemsControl" ItemsSource="{Binding FavoriteItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundMediumBrush}"
                                                CornerRadius="6"
                                                Padding="8"
                                                Margin="0,0,12,12"
                                                Width="180"
                                                ToolTip="{Binding FilePath}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="120"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                                        <Border Background="#80000000"
                                                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="加载中..." Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Border Background="#80000000">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                                                                <Condition Binding="{Binding Exists}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="无预览" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Border Background="#80000000"
                                                                Visibility="{Binding Exists, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <TextBlock Text="文件不存在" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                           Foreground="{StaticResource ForegroundBrush}"
                                                           FontSize="12"
                                                           Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                    <Button Content="定位" Style="{StaticResource ModernButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                                                            IsEnabled="{Binding Exists}"
                                                            Click="OpenFavoriteInExplorer_Click"/>
                                                    <Button Content="取消收藏" Style="{StaticResource ModernButtonStyle}" Padding="10,6"
                                                            Click="RemoveFavorite_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 关联页 -->
            <Grid x:Name="AssociationsPage" Visibility="Collapsed" Margin="0,50,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                     
                         <TextBlock Text="选择要关联的图片格式，勾选后写入注册表，将所选格式默认打开方式改为 ImageViewer；如未生效，可重启资源管理器或手动检查默认应用。"
                                    TextWrapping="Wrap" Foreground="{StaticResource ForegroundDimBrush}"
                                    Margin="0,0,0,12"/>
                        <TextBlock Text="RAW 格式优先使用系统 WIC 解码（建议从微软商店安装 Raw Image Extension）；若系统不支持则自动回退到 Magick.NET。"
                                   TextWrapping="Wrap" Foreground="{StaticResource ForegroundDimBrush}"
                                   Margin="0,0,0,12"/>
 
                         <StackPanel x:Name="AssociationsPanel" Margin="0,8,0,0">
                             <TextBlock Text="选择要关联的图片格式"
                                        Foreground="{StaticResource ForegroundBrush}"
                                        FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding AssociationOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Foreground="{StaticResource ForegroundBrush}"
                                                      Margin="0,0,12,8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Button Content="全选" Style="{StaticResource ModernButtonStyle}" Width="70" Margin="0,0,8,0"
                                        Click="SelectAllAssociations_Click"/>
                                <Button Content="取消全选" Style="{StaticResource ModernButtonStyle}" Width="80"
                                        Click="ClearAllAssociations_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="ApplyAssociationsButton"
                                Content="关联所选格式"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="ApplyAssociationsButton_Click"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>

</Window>
