<Window x:Class="ImageViewer.Views.ArchivePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="需要密码" 
       SizeToContent="WidthAndHeight"
        Width="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundMediumBrush}">

    <Border Background="{StaticResource BackgroundMediumBrush}"
            BorderBrush="{StaticResource BackgroundLightBrush}"
            BorderThickness="1"
            Padding="16">
        <Grid Width="240">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="该压缩包需要密码"
                       Foreground="{StaticResource ForegroundBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding ArchiveDisplayName}"
                       Foreground="{StaticResource ForegroundDimBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,12"/>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <PasswordBox x:Name="PasswordBox"
                             Height="32" Width="Auto"
                             FontSize="14"  VerticalContentAlignment="Center"
                             Padding="8,0"/>
                <TextBlock x:Name="ErrorText"
                           Visibility="Collapsed"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="90"
                        Height="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Style="{StaticResource ModernButtonStyle}"
                        Click="Cancel_Click"/>
                <Button Content="确定"
                        Width="90"
                        Height="32"
                        IsDefault="True"
                        Style="{StaticResource ModernButtonStyle}"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

